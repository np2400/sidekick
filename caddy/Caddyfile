# Caddy: the front door on the server. It gets a free HTTPS certificate from Let's Encrypt for your
# domain (and renews it), then passes allowed requests to Sidekick inside Docker's private network.
{$SIDEKICK_DOMAIN} {
	# Only these app paths are open to the internet; /echo, /docs etc. stay private.
	handle /telegram/webhook {
		reverse_proxy sidekick:8000
	}
	handle /health {
		reverse_proxy sidekick:8000
	}
	# Where Google returns a member's browser after they connect their calendar (/connect).
	handle /oauth/google/callback {
		reverse_proxy sidekick:8000
	}
	# Sidekick Web (W3): the one-time link from /web in Telegram, signing in with Google, and the API.
	handle /link {
		reverse_proxy sidekick:8000
	}
	handle /auth/* {
		reverse_proxy sidekick:8000
	}
	handle /api/* {
		reverse_proxy sidekick:8000
	}
	# The web app itself, built from web/ by deploy/deploy.py. A path inside it that isn't a file (e.g.
	# /app/chat/12) loads the app, which shows the right page.
	redir /app /app/
	handle_path /app/* {
		root * /web/dist
		try_files {path} /index.html
		file_server
	}
	# Two static pages (site/), required by Google's sign-in screen: a home page and a privacy policy.
	handle / {
		root * /srv
		rewrite * /index.html
		file_server
	}
	handle /privacy {
		root * /srv
		rewrite * /privacy.html
		file_server
	}
	handle {
		respond 404
	}
}
