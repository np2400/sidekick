# Leave blank until needed. Never commit real credentials.
TELEGRAM_BOT_TOKEN=
# Random string; generate with: python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
TELEGRAM_WEBHOOK_SECRET=
# Your numeric Telegram user id; the server log prints it the first time you message the bot.
TELEGRAM_OWNER_ID=
GEMINI_API_KEY=
# Free key from console.groq.com -> API Keys. Optional: without it, Groq candidates are skipped.
GROQ_API_KEY=
# Optional model order, best first, as provider:model (default in app/config.py), e.g.
# gemini:gemini-3.8-flash,groq:qwen/qwen3.8-27b,gemini:gemini-3.5-flash-lite
LLM_CANDIDATES=
# Optional model order for messages with a photo (vision models only), e.g.
# gemini:gemini-3.5-flash,groq:qwen/qwen3.8-27b
LLM_VISION_CANDIDATES=
# Optional: providers that must never see email content, e.g. groq
LLM_BLOCK_SENSITIVE=
TODOIST_API_TOKEN=
# Optional: web search, free key from tavily.com (1,000 searches a month)
TAVILY_API_KEY=
# Optional: "todoist" to keep tasks in Todoist instead of Sidekick's built-in list (default: native)
TASK_BACKEND=
# Optional: how often reminders are checked, in seconds (default 10)
REMINDER_POLL_SECONDS=
# Optional: time of the automatic morning brief, HH:MM in the owner's timezone (default 08:00; empty = off)
# DAILY_BRIEF_TIME=08:00
# Optional: 0 turns off the reminder scheduler, e.g. on a laptop while the server sends reminders
SIDEKICK_SCHEDULER=

# --- Server only (docker compose) ---
# "public" also starts Caddy (HTTPS) and Litestream (backups)
COMPOSE_PROFILES=
# Domain pointing at the server, e.g. my-sidekick.duckdns.org
SIDEKICK_DOMAIN=
# Where Litestream backs up the database, e.g. s3://my-bucket/sidekick and us-east-2
SIDEKICK_BACKUP_URL=
SIDEKICK_BACKUP_REGION=
