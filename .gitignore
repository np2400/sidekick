.venv/
__pycache__/
.pytest_cache/
*.pyc
.env
.env.*
!.env.example
google_client_secret.json
google_token.json
*.db
*.db-*
*.sqlite3
.DS_Store

# Eval reports: the .md summaries are small and shareable; the .json files hold full traces and get big.
evals/reports/*.json

# Docker data folder (database + Google tokens for the container)
data/
uploads/

# Private keys (e.g. an AWS .pem) must never be committed
*.pem
*.key

# Server-side deploy state: a commit that failed its health check (deploy/deploy.py)
.deploy-failed

# Sidekick Web (frontend)
web/node_modules/
web/dist/
